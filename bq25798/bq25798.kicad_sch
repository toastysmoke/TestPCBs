	(rectangle
		(start 92.71 38.1)
		(end 195.58 83.82)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(uuid "a50332f1-a302-496a-9e50-0193cbc1fa71")
	)
	(text "Most PD compliant devices at 5V can only negotiate up to 3A\n where as the Crowdspec device needs up to 5A (25W) to be stable.\n\nTo get around this limitation, we can instead negotiate for 9V 3A (27W) to get the same energy density with less current. \nSince the Compute Module 5 cannot negotiate for 9V 3A,\nwe have to implement the negotiation and override the expected handshake of the CM5."
		(exclude_from_sim no)
		(at 78.994 21.844 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "22f2a9b3-a407-4d48-8904-c1778dd16a1a")
	)
	(text "The sink controller negotiates for 9V 3A where it then is recieved by the BQ25798.\nIt automatically bucks the 9V down to the 7.4V voltage of the battery.\nThis allows the IC to safely charge the battery.\nThe BQ25798's SYS outupt voltage is dependent on the battery voltage.\nWith the output current limit at 5A, it is better for us to buck down\nfrom a higher voltage rather than boosting from a lower one. Any battery\nvoltage higher than 5V will do.\n"
		(exclude_from_sim no)
		(at 190.5 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "31a1d505-49d0-4937-a806-d3e35222c448")
	)
	(text "PD sink controller (9V)"
		(exclude_from_sim no)
		(at 139.192 42.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "397f8712-6e2e-4a30-9455-135ca0b29eeb")
	)
	(text "2.99A Input current limit"
		(exclude_from_sim no)
		(at 127 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "55da7a92-a52f-4b70-abe7-377469dc0505")
	)
	(text "QON pin(Internally pulled up)\n- Low for atleast 15ms = Exit shipping mode\n- Low for atleast 10s = IC hardware reset"
		(exclude_from_sim no)
		(at 223.012 72.136 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9dc5c83d-5a02-4edc-85f1-6dfbf088c5e9")
	)
	(text "USB-C Power input interface"
		(exclude_from_sim no)
		(at 51.308 41.91 0)
